# Copy this file to .env and fill in real values. .env is ignored by Git, never commit it.

# --- Database (the one main.py uses) ---
DB_CONN=postgresql://postgres:CHANGE_ME@localhost:5432/jbaya

# --- Secrets: each must be a long random string (40+ characters) ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_SECRET=
MASTER_CODE_SECRET=

# --- WhatsApp Business (Meta Cloud API) ---
# console = print messages in this terminal (development). live = really send.
WHATSAPP_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=ar
WA_TEMPLATE_OTP=jbaya_otp
WA_TEMPLATE_BILL_NOTICE=jbaya_bill_notice
WA_TEMPLATE_RECEIPT=jbaya_receipt
HOTLINE=8000

# --- Rules you may want to tune ---
COMPANY_FEE_IQD=3000
# % of the water amount the company keeps under its contract (the rest is the directorate's trust money)
COMPANY_SHARE_PCT=0
FIRST_VISIT_PERIOD_DAYS=30
MASTER_CODE_WINDOW_SECONDS=600
MASTER_CODE_DAILY_LIMIT_PER_COLLECTOR=3
MAX_DISTANCE_FROM_PROPERTY_M=150
MAX_GPS_ACCURACY_METERS=50
ENFORCE_GEOFENCE=true

# --- Phase 1: field cash & evidence ---
CASH_IN_HAND_CAP_IQD=1500000
COLLECTOR_DAILY_TARGET_IQD=500000
REQUIRE_METER_PHOTO=true
RECON_TOLERANCE_IQD=0
# where meter / bank-slip photos are stored (relative to jbaya-backend)
STORAGE_DIR=storage

# --- Phase 2: live tracking & Command security ---
# (Phase 5: employees no longer get WhatsApp login codes; devices are approved in the tech panel instead)
# Optional: only allow these roles to log in from these networks (comma separated, e.g. 192.168.1.0/24,10.0.0.5)
COMMAND_IP_ALLOWLIST=
IP_RESTRICTED_ROLES=command,admin
PING_ONLINE_SECONDS=300

# --- Phase 3: HR ---
SHIFT_START=08:00
LATE_GRACE_MINUTES=15
# Python weekday numbers (Mon=0 ... Fri=4, Sat=5); comma separated
WEEKEND_DAYS=4
REQUIRE_SELFIE=true
LEAVE_ANNUAL_DAYS=20
LEAVE_SICK_DAYS=15
LEAVE_EMERGENCY_DAYS=5
# paid per receipt the citizen confirmed with the WhatsApp code
COMMISSION_PER_RECEIPT_IQD=500
# set the real Iraqi rates before go-live (0 = not deducted)
INCOME_TAX_PCT=0
SOCIAL_SECURITY_PCT=0
WARNINGS_BEFORE_SUSPENSION=3

# --- Phase 4b: owner panel, cash at headquarters, performance ---
# write-offs and manual corrections above this amount wait for the owner's approval
OWNER_APPROVAL_IQD=250000
# HQ count differences up to this are accepted automatically
HANDOVER_TOLERANCE_IQD=0
# owner is alerted when more cash than this is still with collectors and supervisors
CASH_OUTSIDE_HQ_ALERT_IQD=10000000
# consecutive losing days before a collector is flagged
LOSING_STREAK_ALERT_DAYS=3

# --- Phase 5: tech panel, devices, switches, 35% rule ---
# Everything below can also be changed live from the tech panel (TECH-01); .env is only the starting value.
# A new phone / PC must be approved once in the tech panel (the very first TECH-01 device is approved by itself).
DEVICE_APPROVAL_REQUIRED=true
# approved devices allowed per role at the same time
DEVICE_LIMITS=collector:1,supervisor:1,finance:2,hr:2,command:2,owner:2,admin:2,tech:3
# every session ends daily at this local time
DAILY_LOGOUT_AT=00:00
# citizen numbers: refuse above / flag a code typed faster than / flag houses further apart than
PHONE_HARD_LIMIT_PROPERTIES=10
FAST_OTP_SECONDS=8
PHONE_SPREAD_KM=3
CALLBACK_DAILY_SAMPLE=10
# 35% rule: not_set | baseline_2025 | per_house  (leave not_set until the contract wording is confirmed)
GAIN_SHARE_MODE=not_set
GAIN_SHARE_PCT=35
WHATSAPP_COST_USD=0.0079
