# Copy this file to .env and fill in real values. .env is ignored by Git, never commit it.

# --- Database (the one main.py uses) ---
DB_CONN=postgresql://postgres:CHANGE_ME@localhost:5432/jbaya

# --- Secrets: each must be a long random string (40+ characters) ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_SECRET=
MASTER_CODE_SECRET=

# --- WhatsApp Business (Meta Cloud API) ---
# console = print messages in this terminal (development). live = really send.
WHATSAPP_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=ar
WA_TEMPLATE_OTP=jbaya_otp
WA_TEMPLATE_BILL_NOTICE=jbaya_bill_notice
WA_TEMPLATE_RECEIPT=jbaya_receipt
HOTLINE=8000

# --- Rules you may want to tune ---
COMPANY_FEE_IQD=3000
FIRST_VISIT_PERIOD_DAYS=30
MASTER_CODE_WINDOW_SECONDS=600
MASTER_CODE_DAILY_LIMIT_PER_COLLECTOR=3
MAX_DISTANCE_FROM_PROPERTY_M=150
MAX_GPS_ACCURACY_METERS=50
ENFORCE_GEOFENCE=true

# --- Phase 1: field cash & evidence ---
CASH_IN_HAND_CAP_IQD=1500000
COLLECTOR_DAILY_TARGET_IQD=500000
REQUIRE_METER_PHOTO=true
RECON_TOLERANCE_IQD=0
# where meter / bank-slip photos are stored (relative to jbaya-backend)
STORAGE_DIR=storage

# --- Phase 2: live tracking & Command security ---
# Roles that must confirm a WhatsApp code at login (the employee needs a phone number on file)
TWO_FACTOR_ROLES=command,admin
COMMAND_SESSION_HOURS=8
# Optional: only allow Command logins from these networks (comma separated, e.g. 192.168.1.0/24,10.0.0.5)
COMMAND_IP_ALLOWLIST=
PING_ONLINE_SECONDS=300
